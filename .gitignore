# Xcode (the project is generated from project.yml); build caches (Wisconsin's public repo once picked up a 180 MB DerivedData folder)
*.xcodeproj
DerivedData/
DerivedData*/
build/
*.xcarchive
xcuserdata/
.DS_Store

# Python
.venv/
__pycache__/
*.pyc

# Large, raw or regenerable data (see CLAUDE.md "Rebuild"). Only our own research, the id history and the chain sales list are kept.
data/*.json.gz
data/me/
data/app/
data/raw/
data/research/source_hosts.json

# The web leaderboard's data carries Google Local 2021-derived ratings and review signals. It is regenerated by pipeline/maine.py and
# published only as a private Artifact, so it never goes in this public repo. Its URL lives in LOCAL.md.
site/
LOCAL.md

# QA reports (local only: they quote private paths and identifiers)
qa/
screenshots/small-*.png

# secrets and signing material never go in a public repo
.env
.env.*
*.p8
*.p12
*.pem
*.key
*.cer
*.mobileprovision
AuthKey_*
.claude/settings.local.json
